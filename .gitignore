.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
.DS_Store

# Large generated binaries (keep SVGs/DXF small previews if useful)
exports/**/*.step
exports/**/*.stp
exports/**/*.stl
exports/**/*.brep
exports/**/*.png
exports/**/*.pdf
exports/**/*.usdz

# Tracked review previews live under docs/previews/
!docs/previews/**/*.png
!docs/previews/**/*.svg

# GitHub Pages Quick Look inputs (USDZ via LFS). Hub HTML is CI-generated.
!docs/models/**/*.usdz
!docs/models/**/*.glb
!docs/models/**/*.json
!docs/.nojekyll
docs/index.html
# Realistic-mode catalogue, copied from inputs/materials by preview_hub.sync_materials_site
docs/materials/catalogue.yaml

# Local secrets / editor
.env
.idea/
.vscode/

# Viewer toolchain and builds. `npm run build` (src/blueprints/viewer/build.mjs)
# writes dist/ (ES modules for the site) and viewer.iife.js (offline HTML export);
# CI builds them, nothing is committed. ensure_viewer_shell copies dist/ into
# docs/viewer/.
src/blueprints/viewer/node_modules/
src/blueprints/viewer/dist/
src/blueprints/viewer/viewer.iife.js
docs/viewer/viewer.js
docs/viewer/chunks/
docs/viewer/viewer.iife.js
exports/**/*.glb
exports/**/*.html
